FROM python:3.13-slim

ARG GIT_HASH
LABEL git.hash=$GIT_HASH

ARG UID=1000
ARG GID=1000

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/home/fltech/Workspace/StorageManager

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN set -e; \
    existing_user=$(getent passwd "$UID" | cut -d: -f1); \
    existing_group=$(getent group "$GID" | cut -d: -f1); \
    if [ -n "$existing_user" ]; then \
        usermod -l fltech -d /home/fltech -m "$existing_user"; \
    else \
        useradd -N -m -u "$UID" -s /bin/bash fltech; \
    fi; \
    if [ -n "$existing_group" ]; then \
        groupmod -n fltech "$existing_group"; \
    else \
        groupadd -g "$GID" fltech; \
    fi; \
    usermod -g fltech fltech

WORKDIR /home/fltech/Workspace/StorageManager

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY config/ config/
COPY scripts/ scripts/

RUN chown -R fltech:fltech /home/fltech/Workspace/StorageManager

USER fltech

CMD ["python3", "src/service.py"]
